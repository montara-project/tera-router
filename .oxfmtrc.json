{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "ignorePatterns": [
    "next-env.d.ts",
    "tsconfig.tsbuildinfo",
    "**/node_modules/",
    "**/dist/",
    "**/.next/",
    "**/.source/"
  ]
}
