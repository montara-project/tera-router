{
  "name": "@tera/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "npm-run-all format lint typecheck",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "postinstall": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next node_modules .source .turbo"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.7",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.7",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint-plugin-perfectionist": "^5.11.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2"
  }
}
