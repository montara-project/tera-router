{
  "name": "@tera/docs",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "prebuild": "npm-run-all format lint",
    "build": "vite build",
    "postbuild": "tsc --noEmit",
    "start": "vite preview --port 3001",
    "preview": "npm run build && npm run start --",
    "deploy": "cf deploy",
    "cf-typegen": "wrangler types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules .turbo src/routeTree.gen.ts .cloudflare",
    "predeploy": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "fumadocs-core": "^16.15.7",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.5",
    "eslint-plugin-perfectionist": "^5.11.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
