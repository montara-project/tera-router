# Machine
MACHINE_ID=1

# App
DEBUG=true
ENV=development
PORT=8080
APP_NAME=tera-router-server
# Required: signs JWT access tokens and derives the secret-sealing KEK.
APP_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# SQLite database file (created on first run)
DATABASE_PATH=terarouter.db

# Seeded admin account (used by `make seed` / `make seed/dev`). Changing
# ADMIN_EMAIL renames the existing admin on the next seed and changing
# ADMIN_PASSWORD updates its password; either one ends every open session.
# Leave ADMIN_PASSWORD empty: development falls back to a known password, and
# a production seed refuses to start without one. Setting it keeps
# re-imposing the password (and revoking sessions) on every boot.
ADMIN_EMAIL=admin@tera.local
ADMIN_PASSWORD=
# Set to true to turn off the admin's two-factor authentication on the next
# seed (lost authenticator). Unset it again after signing in.
# ADMIN_TOTP_RESET=true

SENTRY_DSN=

# Apply pending SQL migrations on server boot (true/false)
MIGRATE_ON_BOOT=false

# Run baseline seeders on server boot after migrating (true/false).
# With ENV=development this also mints the sample API key.
SEED_ON_BOOT=true

# Default Headroom proxy URL for Settings > Token Saving (a URL saved in the
# dashboard overrides it). Unset: http://localhost:8787
HEADROOM_URL=
# Bearer token for a Headroom proxy bound beyond loopback (compose sidecar).
HEADROOM_PROXY_TOKEN=

# Dashboard SSO via any OIDC provider (Pocket ID, Keycloak, Authentik, …).
# Enabled only when all three are set. Register the callback URL
# {public URL}/v1/auth/oidc/callback with the provider.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Label shown on the login button ("Continue with Pocket ID").
# OIDC_PROVIDER_NAME=Pocket ID
# Callback URL registered at the provider. Leave empty to derive it from the
# request ({public URL}/v1/auth/oidc/callback); set it when the public scheme
# or host differs from what the server sees, e.g. TLS ended at a proxy.
# OIDC_REDIRECT_URL=https://router.example.com/v1/auth/oidc/callback
# Refuse sign-ins whose email the provider has not verified (default true).
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# Hide and refuse password and passkey sign-in so SSO is the only way in;
# applies only while OIDC is enabled (default false).
# OIDC_DISABLE_PASSWORD_LOGIN=true
# Let an OIDC sign-in link itself to an existing account with the same email
# (default true). Off: only provisioned/already-linked accounts may use SSO.
# OIDC_LINK_EXISTING_ACCOUNTS=true
