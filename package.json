{
  "name": "tera-router",
  "version": "0.5.4",
  "private": true,
  "description": "Tera Router monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @tera/server dev",
    "dev:web": "pnpm --filter @tera/web dev",
    "dev:docs": "pnpm --filter @tera/docs dev",
    "dev:main": "pnpm --filter @tera/main dev",
    "deploy:main": "pnpm --filter @tera/main run deploy",
    "prebuild": "npm-run-all format lint",
    "build": "pnpm -r build",
    "release": "release-it",
    "release:prepare": "release-it --ci --no-git.tag --no-git.push --no-github.release",
    "release:publish": "release-it --ci --no-increment --no-git.commit --no-git.push --github.release",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "clean": "pnpm -r clean",
    "doctor": "npx react-doctor@latest",
    "update:monorepo": "pnpx npm-check-updates -i --deep --doctorInstall pnpm",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "12.0.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "release-it": "21.1.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0"
}
