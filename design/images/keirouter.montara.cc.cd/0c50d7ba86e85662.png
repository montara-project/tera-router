<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>KeiRouter</title>
    <link rel="icon" type="image/png" href="/keirouter-favicon.png" />
    <meta name="color-scheme" content="light dark" />
    <!-- Apply the saved theme before first paint so dark mode never flashes
         white while the app bundle downloads. Mirrors ThemeProvider. -->
    <script>
      try {
        var t = localStorage.getItem("keirouter-theme");
        if (t === "dark" || (t === "system" && matchMedia("(prefers-color-scheme: dark)").matches))
          document.documentElement.classList.add("dark");
      } catch (e) {}
    </script>
